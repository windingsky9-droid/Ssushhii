  "description": "MCP server for birth charts: planetary positions, houses, aspects, chart comparison, transits and sky events, with an inline chart-wheel view.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "birth-sky-mcp-server": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "tsc && node --test test/*.test.mjs",
    "clean": "rm -rf dist"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist",
    "ui",
    "README.md"
  ]
}
